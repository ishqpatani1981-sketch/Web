{
  "name": "pens-outlet",
  "version": "0.1.0",
  "private": true,
  "description": "Pens Outlet — premium cinematic e-commerce for autograph, collectable and luxury writing instruments.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "db:reset-local": "rm -rf .data/pglite && echo 'Local demo database removed; it will be recreated and seeded on next start.'",
    "test:e2e": "node scripts/e2e.cjs",
    "render:imagery": "node scripts/render-imagery.cjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource/instrument-serif": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.2.0",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
