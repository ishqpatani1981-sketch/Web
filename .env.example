# ═══════════════════════════════════════════════════════════════════════════
#  PENS OUTLET — environment configuration
#  Copy to .env.local for local development. On Vercel, add these under
#  Project → Settings → Environment Variables. NEVER commit real values.
#  Anything prefixed NEXT_PUBLIC_ is visible in the browser — never put a
#  secret in a NEXT_PUBLIC_ variable.
#  Full explanations: docs/CONFIGURATION.md
# ═══════════════════════════════════════════════════════════════════════════

# ── Site ────────────────────────────────────────────────────────────────────
# Public URL of the site (used in emails, sitemap, Stripe redirects, SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true = demo payments allowed while Stripe is NOT configured (orders flagged
# "demo", no money taken). Set to false (or remove) before launch.
DEMO_MODE=true
# Search engines are blocked (robots.txt) until this is true. Set at launch.
ALLOW_INDEXING=false

# ── Administrator (first admin account, created by `npm run db:seed`) ──────
ADMIN_EMAIL=
# Use a long, unique password (16+ characters). Change it after first login.
ADMIN_PASSWORD=

# ── Database: Supabase Postgres ─────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string → "Transaction
# pooler" (port 6543). Leave empty to use the embedded demo database.
DATABASE_URL=
DATABASE_POOL_MAX=5
# true = run migrations automatically on startup (otherwise `npm run db:migrate`).
AUTO_MIGRATE=false

# ── Image storage: Supabase Storage ─────────────────────────────────────────
# Supabase → Project Settings → API. The service role key is SECRET (server only).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ── Payments: Stripe ────────────────────────────────────────────────────────
# Start with TEST keys (sk_test_ / pk_test_). Swap for live keys at launch.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe → Developers → Webhooks → endpoint https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# ── Transactional email (order confirmations, notifications) ───────────────
# resend | brevo | log   (log = record in admin outbox only, nothing delivered)
EMAIL_PROVIDER=log
RESEND_API_KEY=
# Sender must be on a domain verified with your email provider.
EMAIL_FROM="Pens Outlet <orders@your-domain.co.uk>"
EMAIL_REPLY_TO=
# Fallback recipient for owner alerts (Admin → Settings can also set this).
OWNER_NOTIFICATION_EMAIL=

# ── Email marketing (newsletter contact sync) ───────────────────────────────
# brevo | mailchimp | none
EMAIL_MARKETING_PROVIDER=none
BREVO_API_KEY=
BREVO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# e.g. us21 (the suffix of the Mailchimp API key)
MAILCHIMP_SERVER_PREFIX=

# ── Scheduled campaigns ─────────────────────────────────────────────────────
# Random string (e.g. `openssl rand -hex 32`). Vercel Cron sends it automatically.
CRON_SECRET=

# ── Analytics (only loaded after visitor consent) ───────────────────────────
# Can also be set in Admin → Website content → Analytics.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
